# Valores locais de exemplo usados pelo docker-compose.yml (copie para .env para alterar).
# Nenhum segredo real: todos os valores abaixo valem apenas para o ambiente local.

# --- PostgreSQL ---
# Dono do schema: usado apenas pelas migrations.
POSTGRES_USER=wagering_owner
POSTGRES_PASSWORD=wagering_owner_local
POSTGRES_DB=wagering
# Papel de menor privilégio usado pelo serviço (sem UPDATE/DELETE no ledger).
WALLET_APP_PASSWORD=wallet_app_local
POSTGRES_HOST_PORT=55432

# --- Keycloak (IdP) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOST_PORT=8180

# --- SQS (LocalStack) ---
AWS_REGION=us-east-1
LOCALSTACK_HOST_PORT=4566
# Credencial do serviço no broker.
SERVICE_AWS_ACCESS_KEY_ID=wallet-service
SERVICE_AWS_SECRET_ACCESS_KEY=wallet-service-local-secret
# Credencial do provisionamento das filas.
ADMIN_AWS_ACCESS_KEY_ID=provisioner
ADMIN_AWS_SECRET_ACCESS_KEY=provisioner-local-secret
SQS_MAX_RECEIVE_COUNT=5

# --- Serviço ---
LOG_LEVEL=info
DATABASE_MAX_CONNS=20
PENDING_BACKOFF_BASE=2s
PENDING_MAX_ATTEMPTS=10
PENDING_TTL=15m
